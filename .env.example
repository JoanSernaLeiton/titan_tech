# =============================================================================
# REQUIRED — fill these in before running pnpm dev
# =============================================================================

# Supabase — https://supabase.com > Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Supabase DB — https://supabase.com > Project Settings > Database > Connection string > Transaction mode (URI)
# Port 6543 = transaction mode (PgBouncer) — used by the app at runtime
DATABASE_URL=postgresql://postgres.your-project-id:[password]@aws-0-[region].pooler.supabase.com:6543/postgres

# Direct connection — used only by drizzle-kit migrations (DDL needs a real session)
# https://supabase.com > Project Settings > Database > Connection string > Direct
DIRECT_URL=postgresql://postgres:Cartago123@db.oortbdzdwslaonppkzkv.supabase.co:5432/postgres
# =============================================================================
# OPTIONAL
# =============================================================================

# App URL (used for OAuth callbacks)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Middleware API base URL
TINKU_BASE_URL=https://techos.thetribu.dev

# Middleware API key — value after "tk_" only (the prefix is added automatically)
TINKU_API_KEY=

# Vercel cron secret (set manually for local testing, auto-generated on Vercel)
CRON_SECRET=
